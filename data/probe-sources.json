image }}\"\n        alt=\"{{ disaster.name_disaster }}\"\n        class=\"w-100 h-100 p-3\"\n      />\n    </div>\n    <div class=\"w-100\">\n      <div class=\"title-disaster\"\n      {{#da_ketthuctmp}}\n      {{/da_ketthuctmp}}\n      {{^da_ketthuctmp\n      }}\n      style=\"color: red;\"\n      {{/da_ketthuctmp}}\n      ><b>{{ rowNum }}. {{ name_vn }} / {{ name_en }}</b>\n    </div>\n    {{#da_ketthuctmp}}\n    <div class=\"title-disaster\">\n      <b>Thời gian bắt đầu:</b> {{ time_start_toString }}\n    </div>\n    <div class=\"title-disaster\">\n      <b>Thời gian kết thúc:</b> {{ time_update_toString }}\n    </div>\n    {{/da_ketthuctmp}} {{^da_ketthuctmp}}\n    <div class=\"title-disaster\">\n      <b>Thời gian: </b> {{ time_update_toString }}\n    </div>\n    {{/da_ketthuctmp}}\n    <div class=\"title-disaster\"><b>Vị trí:</b> {{ lon }} - {{ lat }}</div>\n    <div class=\"title-disaster\"><b>Cấp bão:</b> {{ level }}</div>\n    <div class=\"title-disaster\">\n      <b>Hướng di chuyển:</b> {{ huong_dichuyen }}\n    </div>\n    <div class=\"title-disaster\"><b>Vùng ảnh hưởng:</b> {{ kv_anhhuong }}</div>\n    <div class=\"title-disaster\">\n      <b>Cấp độ rủi ro thiên tai:</b> {{ disaster_level }}\n    </div>\n  </div>\n  <div class=\"show-info\">\n    <a\n      class=\"btn-info-disaster disaster-storm\"\n      href=\"#info\"\n      data-id=\"{{ id }}\"\n      data-name=\"{{ disaster.name_disaster }}\"\n      data-lon=\"{{ lon }}\"\n      data-lat=\"{{ lat }}\"\n      ><i class=\"fa fa-chevron-right i-storm\" title=\"Xem chi tiết\"></i\n    ></a>\n  </div>\n</div>\n"},{"url":"https://vndms.gov.vn/bundles/templates/sktt/sktt-common-item.tmpl","method":"GET","post":"","status":200,"type":"text/html","size":1363,"sample":"<div class=\"item-event\">\n  <div class=\"d-flex justify-content-center align-items-center\">\n    <div class=\"w-25\">\n      <img\n        src=\"data:image/svg+xml;base64,{{ disaster.image }}\"\n        alt=\"{{ disaster.name_disaster }}\"\n 