: 1050;\n    top: 50px;\n    left: 0; */\n    border-radius: 0;\n    box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.2), 0 6px 20px 0 rgba(0, 0, 0, 0.19);\n    background-color: white;\n    animation-name: animatetopLoaiThienTai;\n    animation-duration: 0.4s;\n  }\n\n  .sktt__main .sktt__toolbar_ltt_toggle,\n  .sktt__main .sktt__toolbar_clear {\n    font-size: 15px;\n    padding: 4px 6px;\n  }\n\n  .sktt__main .sktt__toolbar_ltt_toggle:hover,\n  .sktt__main .sktt__toolbar_clear {\n    color: red !important;\n  }\n\n  .sktt__main .sktt-ltt-list>ul {\n    list-style-type: none;\n    margin: 10px 0;\n    padding: 0 10px;\n  }\n\n  .sktt__main .sktt-ltt-list>ul>li {\n    padding: 3px 0;\n  }\n\n  .sktt__main .sktt-ltt-list>ul>li>label>img {\n    height: 16px;\n    width: 16px;\n    margin-left: 4px;\n  }\n\n  .sktt_"},{"url":"https://vndms.gov.vn/bundles/templates/sktt/sktt-detail.tmpl","method":"GET","post":"","status":200,"type":"text/html","size":18875,"sample":"<div class=\"infomation-disaster h-100\">\n  <div class=\"d-flex flex-column h-100\">\n    <ul class=\"nav nav-tabs nav-fill\">\n      <li class=\"nav-item\">\n        <a\n          href=\"#vndms__sktt_detail_tttt\"\n          data-toggle=\"tab\"\n          class=\"nav-link active\"\n        >\n          <div class=\"icon\"><i\n              class=\"fa fa-bars\"\n              aria-hidden=\"true\"\n            ></i></div>\n          <div class=\"title-icon\">TT tóm tắt</div>\n        </a>\n      </li>\n      <li class=\"nav-item \">\n        <a\n          href=\"#vndms__sktt_detail_document\"\n          data-toggle=\"tab\"\n          class=\"nav-link\"\n        >\n          <div class=\"icon\"><i\n              class=\"fa-regular fa-file-lines\"\n              aria-hidden=\"true\"\n            ></i></div>\n          <div class=\"title-icon\">VB chỉ đạo</div>\n        </a>\n      </li>\n      <li class=\"nav-item \">\n        <a\n          href=\"#infomation-disaster\"\n          data-toggle=\"tab\"\n          class=