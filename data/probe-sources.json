ex-shrink: 0;\n  }\n\n  .legend-label {\n    font-size: 12px;\n    color: #333;\n    line-height: 1.3;\n  }\n</style>\n"},{"url":"https://vndms.gov.vn/bundles/templates/legend-windy.tmpl","method":"GET","post":"","status":200,"type":"text/html","size":937,"sample":"<div class=\"wind-notes\">\n  <p\n    class=\"notes-title\"\n    id=\"legend-title\"\n  >Ghi chú theo tốc độ gió</p>\n  <div\n    class=\"wind-gradient wind-legend\"\n    id=\"map-legend-wind-level\"\n    style=\"display:none;margin-bottom:10px;\"\n  >\n    <span class=\"wind-step-item wind-step-unit\">Cấp gió</span>\n    <span\n      class=\"wind-step-item\"\n      style=\"width:12.5%\"\n    >0</span>\n    <span\n      class=\"wind-step-item\"\n      style=\"width:12.5%\"\n    >2</span>\n    <span\n      class=\"wind-step-item\"\n      style=\"width:12.5%\"\n    >3</span>\n    <span\n      class=\"wind-step-item\"\n      style=\"width:12.5%\"\n    >4</span>\n    <span\n      class=\"wind-step-item\"\n      style=\"width:12.5%\"\n    >7</span>\n    <span\n      class=\"wind-step-item\"\n      style=\"width:12.5%\"\n    >8</span>\n    <span\n      class=\"wind-step-item\"\n      style=\"width:12.5%\"\n    >11</span>\n  </div>\n  <div\n    class=\"wind-gradient\"\n    id=\"map-legend\"\n  ></div>\n</div>"},{"url":"https://vndms.gov.vn/bundles/templates/modals/maptool-modal.tmpl","method":"GET","post":"","status":200,"type":"text/html","size":1661,"sample":"<!--START ACTION MAP-->\n<div\n  class=\"portlet-box portlet-box-mini portlet-pos-right portlet-expend-right w-auto\"\n  id=\"vndms__maptool_modal\"\n>\n  <div class=\"portlet-content\">\n    <div\n      class=\"action-system portlet-inner d-flex flex-gap-4 p0 m0\"\n      style=\"background: rgba(30, 57, 51, 0.7);\"\n    >\n      <div class=\"action-item\">\n        <a\n          href=\"#\"\n          title=\"Vị trí của tôi\"\n          id=\"vndms__maptool_location_action\"\n          class=\"hover-tooltip\"\n        >\n          <span class=\"icons-coordinates\">&nbsp;</span>\n        </a>\n      </div>\n      <div class=\"action-item\">\n        <a\n          class=\"hover-tooltip\"\n          title=\"Phóng to\"\n          href=\"#\"\n          id=\"vndms__maptool_zoomin_action\"\n        >\n          <span class=\"icons-zoomin\">&nbsp;</span>\n        </a>\n      </div>\n      <div class=\"action-item\">\n        <a\n          class=\"hover-tooltip\"\n          title=\"Thu nhỏ\"\n          href=\"#\"\n          id=\"vndms__maptool_zoomout_action\"\n        >\n          <span class=\"icons-zoomout\">&nbsp;</span>\n        </a>\n      </div>\n      <div class=\"action-item\">\n        <a\n          class=\"hover-tooltip fullscreen\"\n          title=\"Toàn cảnh\"\n          href=\"#\"\n          id=\"vndms__maptool_fullscreen_action\"\n        >\n          <span class=\"icons-fullscreen\">&nbsp;</span>\n        </a>\n      </div>\n      <div class=\"action-item\">\n        <a\n          class=\"hover-tooltip\"\n          title=\"Công cụ\"\n          href=\"#\"\n          id=\"vndms__maptool_more_action\"\n        >\n          <span class=\"fa fa-pencil-square\"></span>\n        </a>\n      </div>\n    </div>\n  </div>\n</div>\n<!--END ACTION MAP-->"},{"url":"https://vndms.gov.vn/bundles/templates/sktt/sktt-modal.tmpl","method":"GET","post":"","status":200,"type":"text/html","size":2574,"sample":"<div class=\"sktt__main list-disaster h-100 overflow-hidden\">\n  <div class=\"sktt__toolbar\">\n    <div class=\"header-disaster\">\n      <div class=\"total-disaster\">\n        <span class=\"sktt__main_inprogress_event\"></span> thiên tai đang diễn ra/ <span class=\"sktt__main_total_event\"></span> thiên tai\n      </div>\n      <div class=\"d-flex pl5 pr5 pt5 pb5\">\n        <input\n          type=\"text\"\n          class=\"sktt__toolbar_search_input mr4\"\n          placeholder=\"Tìm kiếm\"\n        />\n        <select class=\"sktt__toolbar_year_select mr4\"></select>\n        <a\n          class=\"sktt__toolbar_ltt_t